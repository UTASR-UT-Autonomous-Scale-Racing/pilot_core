{
  "name": "pilot_core - Jetson Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // NVIDIA GPU + privileged device access
  "runArgs": [
    "--runtime=nvidia",
    "--privileged",
    "--network=host",
    "--ipc=host"
  ],
  // /dev/bus/usb bind-mount keeps the OAK-D visible when it re-enumerates after start
  "mounts": [
    "type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
    "type=bind,source=/tmp,target=/tmp"
  ],
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "LD_LIBRARY_PATH": "/workspaces/pilot_core/ORB_SLAM3/lib:/usr/local/lib:${containerEnv:LD_LIBRARY_PATH}",
    "PYTHONUNBUFFERED": "1",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  // pip upgraded first: Ubuntu 22.04's pip 22.0 can't do PEP 660 editable installs
  "postCreateCommand": "scripts/setup.sh && python3 -m venv --system-site-packages .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/pip install -r requirements.txt && .venv/bin/pip install --no-deps -e . && echo 'source /workspaces/pilot_core/.venv/bin/activate' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/pilot_core/.venv/bin/python3",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "cmake.configureOnOpen": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.env.linux": {
          "LD_LIBRARY_PATH": "/workspaces/pilot_core/ORB_SLAM3/lib:/usr/local/lib"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-azuretools.vscode-docker",
        "github.copilot"
      ]
    }
  },
  "workspaceFolder": "/workspaces/pilot_core",
  "remoteUser": "developer"
}