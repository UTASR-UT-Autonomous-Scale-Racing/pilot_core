# Dockerfile.dev-local — lightweight container for running the test suite
# (and config_dev_local.yaml) on any machine: no NVIDIA GPU, OAK-D or other
# hardware needed; synthetic frame/depth/IMU data is used instead.
#   docker compose -f docker-compose.dev-local.yaml up --build
# Runs the same tests as CI (.github/workflows/ci.yml), without torch: the
# vision / BC / VAE tests that need it are skipped. For those, build with
#   --build-arg EXTRAS=test,train

FROM python:3.10-slim

# System deps (libgl/glib for OpenCV, libusb for depthai)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libusb-1.0-0 \
    git \
    && rm -rf /var/lib/apt/lists/*

ARG EXTRAS=test
ENV PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/pilot_core

# Dependencies first (cached layer): install the deps declared in pyproject.toml
# through a throw-away copy with empty stand-ins for the packages/modules it
# lists, so source edits don't invalidate this layer. Then the real sources are
# installed editable.
COPY pyproject.toml README.md /tmp/pilot_core/
RUN cd /tmp/pilot_core \
    && python -c 'import re, os; s = open("pyproject.toml").read(); names = lambda k: re.findall(r"\"(\w+)\"", re.search("^" + k + r"\s*=\s*\[(.*?)\]", s, re.M | re.S).group(1)); [os.makedirs(p) for p in names("packages")]; [open(m + ".py", "w").close() for m in names("py-modules")]' \
    && pip install "/tmp/pilot_core[${EXTRAS}]" \
    && pip uninstall -y pilot_core \
    && rm -rf /tmp/pilot_core

COPY . /app/pilot_core
RUN pip install --no-deps -e .

# Force synthetic sensors (start.py honours PILOT_SYNTHETIC=1)
ENV PILOT_SYNTHETIC=1
ENV PYTHONUNBUFFERED=1

# Default: the CI test command (timeout/testpaths come from pyproject.toml)
CMD ["python", "-m", "pytest", "-m", "not oakd and not slam", "-ra"]
