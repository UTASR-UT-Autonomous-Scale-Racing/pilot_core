{
  "name": "pilot_core - Local Dev (no GPU)",
  "build": {
    "dockerfile": "../../Dockerfile.dev-local",
    "context": "../.."
  },
  // No-hardware dev container: synthetic sensors, CPU only (Dockerfile.dev-local).
  // No devices needed (synthetic sensors), so no --privileged. --ipc=host gives
  // the shared-memory ring buffers a large enough /dev/shm.
  "runArgs": [
    "--network=host",
    "--ipc=host"
  ],
  // The image installs pilot_core editable at /app/pilot_core, which is also where
  // VS Code mounts the workspace, so edits are picked up without a rebuild.
  "workspaceMount": "source=${localWorkspaceFolder},target=/app/pilot_core,type=bind",
  // Container environment
  "containerEnv": {
    "PILOT_SYNTHETIC": "1",
    "PYTHONUNBUFFERED": "1"
  },
  // VS Code settings
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "github.copilot"
      ]
    }
  },
  // Workspace folder inside container
  "workspaceFolder": "/app/pilot_core"
}
