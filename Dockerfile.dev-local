# Dockerfile.dev-local — lightweight container for running the test suite
# (and config_dev_local.yaml) on any machine: no NVIDIA GPU, OAK-D or other
# hardware needed; synthetic frame/depth/IMU data is used instead.
#   docker compose -f docker-compose.dev-local.yaml up --build

FROM python:3.10-slim

# System deps (OpenCV headless needs libgl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python deps — no depthai, no smbus2, no onnxruntime-gpu, no torch
RUN pip install --no-cache-dir \
    PyYAML \
    numpy \
    opencv-python-headless \
    scipy \
    pytest \
    pytest-timeout \
    matplotlib \
    pandas \
    tqdm \
    pyzmq \
    osqp \
    onnxruntime

WORKDIR /app/pilot_core
COPY . /app/pilot_core

# Force synthetic sensors (start.py honours PILOT_SYNTHETIC=1)
ENV PILOT_SYNTHETIC=1
ENV PYTHONUNBUFFERED=1

# Default: run the test suite
CMD ["pytest", "tests/", "-v", "--timeout=60", "-x"]
